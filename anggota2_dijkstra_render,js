function txt(content, attrs, parent) {
  let t = el('text', attrs, parent);
  t.textContent = content;
  return t;
}

function edgePath(e) {
  let a = nodes[e.a], b = nodes[e.b];
  if (e.isStraight || !e.cx1) return `M ${a.x} ${a.y} L ${b.x} ${b.y}`;
  return `M ${a.x} ${a.y} C ${e.cx1} ${e.cy1} ${e.cx2} ${e.cy2} ${b.x} ${b.y}`;
}

