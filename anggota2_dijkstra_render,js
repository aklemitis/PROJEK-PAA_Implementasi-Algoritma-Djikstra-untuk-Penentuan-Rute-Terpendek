function render() {
  if (!svg) return;
  svg.innerHTML = '';
  let gBase = el('g', { id: 'g-base', transform: `translate(${vx},${vy}) scale(${scale})` }, svg);
  let gBackground = el('g', { id: 'g-bg' }, gBase);
  let gRoads = el('g', { id: 'g-roads' }, gBase);
  let gBuildings = el('g', { id: 'g-buildings' }, gBase);
  let gVehicle = el('g', { id: 'g-vehicle' }, gBase);
  
  el('rect', { x: 0, y: 0, width: W, height: H, fill: '#2e4326' }, gBackground);
  for (let row = 0; row < 12; row++) {
    for (let col = 0; col < 15; col++) {
      if ((row + col) % 2 === 0) el('rect', { x: col * 100, y: row * 90, width: 60, height: 50, fill: '#2a3e22', opacity: 0.4 }, gBackground);
    }
  }
  
  for (let e of edges) {
    el('path', { d: edgePath(e), fill: 'none', stroke: '#222', 'stroke-width': 18, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }, gRoads);
  }
  for (let e of edges) {
    let pd = edgePath(e);
    el('path', { d: pd, fill: 'none', stroke: '#555', 'stroke-width': 14, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }, gRoads);
    el('path', { d: pd, fill: 'none', stroke: '#999', 'stroke-width': 1, 'stroke-dasharray': '6,8' }, gRoads);
    
    let midPathEl = el('path', { d: pd, fill: 'none', stroke: 'none' }, gRoads);
    let mid = midPathEl.getPointAtLength(e.bezierLen * 0.5);
    gRoads.removeChild(midPathEl);
    
    let jarakLabel = formatJarak(e.bezierLen);
    let boxW = jarakLabel.length > 6 ? 38 : 30;
    el('rect', { x: mid.x - boxW / 2, y: mid.y - 7, width: boxW, height: 12, rx: 2, fill: '#1e1e1e', opacity: 0.75 }, gRoads);
    txt(jarakLabel, { x: mid.x, y: mid.y + 2, 'text-anchor': 'middle', fill: '#f8961e', 'font-size': '8px', 'font-weight': 'bold' }, gRoads);
  }
  for (let i = 0; i < nodes.length; i++) {
    el('circle', { cx: nodes[i].x, cy: nodes[i].y, r: 7, fill: '#555' }, gRoads);
  }
  if (routePath.length >= 2) {
    let dStr = buildRouteSVGPath(routePath);
    el('path', { d: dStr, fill: 'none', stroke: '#f8961e', 'stroke-width': 6, 'stroke-linecap': 'round', 'stroke-linejoin': 'round', opacity: 0.4 }, gRoads);
    routeSvgPath = el('path', { d: dStr, fill: 'none', stroke: '#f8961e', 'stroke-width': 3, 'stroke-linecap': 'round', 'stroke-linejoin': 'round', 'stroke-dasharray': '8,6' }, gRoads);
  } else { 
    routeSvgPath = null; 
  }
  for (let i = 0; i < nodes.length; i++) {
    let n = nodes[i]; drawBuilding(gBuildings, n.bx, n.by, n.asset, i === startN, i === endN, n.id);
  }
  let vpos = getVehiclePos();
  if (vpos) { drawCar(gVehicle, vpos.x, vpos.y, vpos.angle); }
}

function updateLegend() {
  let leg = document.getElementById('legend');
  if (!leg) return;
  let seen = new Set(), items = [];
  for (let n of nodes) { if (n.asset && !seen.has(n.asset.type)) { seen.add(n.asset.type); items.push(n.asset); } }
  leg.innerHTML = '<span style="font-weight:600;">🏙️ Legenda:</span>' +
    items.map(a => `<span class="leg-item"><span class="leg-dot" style="background:${a.color}"></span>${a.label}</span>`).join('') +
    '<span class="leg-item"><span class="leg-dot" style="background:#FFD700;border:1px solid #b8960a"></span>🟡 START</span>' +
    '<span class="leg-item"><span class="leg-dot" style="background:#e63946;border:1px solid #a00010"></span>🔴 FINISH</span>' +
    '<span class="leg-item"><span class="leg-dot" style="background:#f8961e"></span>🍊 JALUR TERPENDEK</span>';
}

function zoom(f, cx, cy) {
  let mw = document.getElementById('map-wrap');
  if (!mw) return;
  if (cx === undefined) cx = mw.clientWidth / 2;
  if (cy === undefined) cy = mw.clientHeight / 2;
  let oldScale = scale;
  scale = Math.max(0.3, Math.min(4, scale * f));
  vx = cx - (cx - vx) * (scale / oldScale);
  vy = cy - (cy - vy) * (scale / oldScale);
  let gb = document.getElementById('g-base');
  if (gb) gb.setAttribute('transform', `translate(${vx},${vy}) scale(${scale})`);
  let zi = document.getElementById('zoominfo');
  if (zi) zi.innerHTML = `Zoom: ${Math.round(scale * 100)}%`;
}

function resetView() {
  vx = 0; vy = 0; scale = 1;
  let gb = document.getElementById('g-base');
  if (gb) gb.setAttribute('transform', 'translate(0,0) scale(1)');
  let zi = document.getElementById('zoominfo');
  if (zi) zi.innerHTML = 'Zoom: 100%';
}

document.addEventListener('DOMContentLoaded', () => {
  let mw = document.getElementById('map-wrap');
  if (!mw) return;
  
  mw.addEventListener('mousedown', e => {
    if (e.button !== 0) return;
    isDrag = true;
    ds = { x: e.clientX, y: e.clientY };
    vs = { x: vx, y: vy };
  });
  window.addEventListener('mousemove', e => {
    if (!isDrag) return;
    vx = vs.x + (e.clientX - ds.x);
    vy = vs.y + (e.clientY - ds.y);
    let gb = document.getElementById('g-base');
    if (gb) gb.setAttribute('transform', `translate(${vx},${vy}) scale(${scale})`);
  });
  window.addEventListener('mouseup', () => { isDrag = false; });
  mw.addEventListener('wheel', e => {
    e.preventDefault();
    let zf = e.deltaY < 0 ? 1.1 : 0.9;
    zoom(zf, e.offsetX, e.offsetY);
  });
});